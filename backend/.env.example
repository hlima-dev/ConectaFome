# ─────────────────────────────────────────────
#  ConectaFome Backend — Environment Variables
#  Copie este arquivo para .env e preencha.
# ─────────────────────────────────────────────

# Aplicação
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:5173

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://conectfome:conectfome@localhost:5432/conectfome_db"

# JWT
JWT_SECRET=troque_este_segredo_em_producao_min_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_em_producao_32c
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# ─── Administrador inicial (OBRIGATÓRIO em produção) ───
# Em NODE_ENV=production o seed cria SÓ este administrador (senha com 12+
# caracteres, diferente da senha pública de demonstração). Em desenvolvimento
# o seed cria contas de exemplo e estas variáveis são ignoradas.
# ADMIN_EMAIL=coordenacao@suaong.org.br
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador ConectaFome
# SEED_DEMO=true   # só para uma demonstração pública: cria as contas de exemplo (senha pública!)

# ─── Geocodificação (endereço -> mapa das rotas) ───
# Nominatim/OpenStreetMap: 1 requisição por segundo e User-Agent identificado.
# GEOCODING_ENABLED=true
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=ConectaFome/1.0 (projeto academico; github.com/hlima-dev/ConectaFome)

# ─── Limites de requisições por IP (a cada 15 min) ───
# Padrões: 100 gerais e 10 de login. Só aumente em teste/captura de telas.
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10

# --- Confiança e prazos ---------------------------------------------------------
# Cadastros novos esperam aprovação da administração (false = aprovação automática)
# REQUIRE_APPROVAL=true
# Horas até uma reserva do receptor, sem rota, voltar ao painel (0 desliga)
# RESERVATION_HOLD_HOURS=24
# Segredo (24+ caracteres) do agendador que chama POST /api/v1/maintenance/run
# CRON_SECRET=
# Quantos proxies existem na frente do app (Render = 1; com o proxy da Vercel = 2)
# TRUST_PROXY=0

# --- Fotos ----------------------------------------------------------------------
# Produção: Supabase Storage (bucket privado). Sem isto, em produção as fotos ficam desligadas.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=doacoes
# Desenvolvimento: sem Supabase, grava em disco (pasta abaixo, ignorada pelo git)
# STORAGE_DIR=./uploads
# Doação sem foto da oferta não pode ser reservada; coleta exige foto
# REQUIRE_OFFER_PHOTO=true
# REQUIRE_PICKUP_PHOTO=true

# --- E-mail (opcional) ----------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=ConectaFome <seu-email-validado@exemplo.com>
